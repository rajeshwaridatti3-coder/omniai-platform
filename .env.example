NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/omniai
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
REDIS_URL=redis://127.0.0.1:6379
ENCRYPTION_KEY=replace_with_32_byte_hex_key
# AI provider (OpenAI-compatible chat completions)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Video provider adapter: runway | replicate | custom
VIDEO_PROVIDER=replicate
VIDEO_API_KEY=
VIDEO_API_BASE_URL=https://api.replicate.com/v1
VIDEO_MODEL_VERSION=
# Meta / Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/oauth/meta/callback
META_GRAPH_VERSION=v22.0
# LinkedIn OAuth + API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/oauth/linkedin/callback
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_VERIFY_TOKEN=
# Other providers
TELEGRAM_BOT_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# OAuth redirect URIs must exactly match the URLs registered in each developer console
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/oauth/youtube/callback
META_VERIFY_TOKEN=choose_a_random_webhook_verification_token
LINKEDIN_API_VERSION=202610
# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Public app URL used in billing redirects
CLIENT_URL=http://localhost:5173
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
